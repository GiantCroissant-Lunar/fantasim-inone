<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FantaSim.Geosphere.Plate.Reconstruction.Contracts</RootNamespace>
    <PackageId>GiantCroissant.FantaSim.Geosphere.Plate.Reconstruction.Contracts</PackageId>
    <AssemblyName>Geosphere.Plate.Reconstruction.Contracts</AssemblyName>
    <Version>$(Version)</Version>
    <Authors>Lunar Horse</Authors>
    <Description>Reconstruction contracts for FantaSim plate geosphere</Description>
    <PackageTags>fantasim;contracts;plate;reconstruction;geosphere</PackageTags>
    <UnifySerializationTargets>MessagePack</UnifySerializationTargets>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="UnifySerializationTargets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Geosphere.Plate.Topology.Contracts\Geosphere.Plate.Topology.Contracts.csproj" />
    <ProjectReference Include="..\Geosphere.Plate.Kinematics.Contracts\Geosphere.Plate.Kinematics.Contracts.csproj" />
    <ProjectReference Include="..\Geosphere.Plate.Partition.Contracts\Geosphere.Plate.Partition.Contracts.csproj" />
    <ProjectReference Include="..\Geosphere.Plate.Motion.Contracts\Geosphere.Plate.Motion.Contracts.csproj" />
    <ProjectReference Include="..\Geosphere.Plate.Velocity.Contracts\Geosphere.Plate.Velocity.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Riok.Mapperly" />
    <PackageReference Include="TimeDete.Time.Primitives" />
    <PackageReference Include="UnifyGeometry.Primitives" />
    <PackageReference Include="UnifySerialization.Abstractions" />
    <PackageReference Include="UnifySerialization.Generators" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
