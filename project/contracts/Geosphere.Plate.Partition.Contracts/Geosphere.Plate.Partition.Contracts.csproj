<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FantaSim.Geosphere.Plate.Partition.Contracts</RootNamespace>
    <PackageId>GiantCroissant.FantaSim.Geosphere.Plate.Partition.Contracts</PackageId>
    <AssemblyName>Geosphere.Plate.Partition.Contracts</AssemblyName>
    <Version>$(Version)</Version>
    <Authors>Lunar Horse</Authors>
    <Description>Partition contracts for FantaSim plate geosphere</Description>
    <PackageTags>fantasim;contracts;plate;partition;geosphere</PackageTags>
    <UnifySerializationTargets>MessagePack</UnifySerializationTargets>
    <NoWarn>MsgPack014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="UnifySerializationTargets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Geosphere.Plate.Polygonization.Contracts\Geosphere.Plate.Polygonization.Contracts.csproj" />
    <ProjectReference Include="..\Geosphere.Plate.Topology.Contracts\Geosphere.Plate.Topology.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UnifyGeometry.Primitives" />
    <PackageReference Include="TimeDete.Time.Primitives" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="UnifySerialization.Abstractions" />
    <ProjectReference Include="..\..\..\..\..\plate-projects\unify-serialization\dotnet\src\UnifySerialization.Generators\UnifySerialization.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
