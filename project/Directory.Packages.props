<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
    <PackageVersion Include="FluentAssertions" Version="8.2.0" />

    <!-- Serialization -->
    <PackageVersion Include="MessagePack" Version="3.1.3" />

    <!-- Messaging & DI -->
    <PackageVersion Include="MessagePipe" Version="1.8.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />

    <!-- ServiceArchi -->
    <PackageVersion Include="GiantCroissant.Plate.ServiceArchi.Contracts" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Plate.ServiceArchi.Core" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Plate.ServiceArchi.SourceGen" Version="0.1.0" />

    <!-- Crosscut Logging -->
    <PackageVersion Include="GiantCroissant.Crosscut.Logging.Contracts" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Crosscut.Logging.Core" Version="0.1.0" />

    <!-- Crosscut Messaging -->
    <PackageVersion Include="GiantCroissant.Crosscut.Messaging.Contracts" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Crosscut.Messaging.MessagePipe" Version="0.1.0" />

    <!-- Crosscut Config -->
    <PackageVersion Include="GiantCroissant.Crosscut.Config.Contracts" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Crosscut.Config.Core" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Crosscut.Config.Json" Version="0.1.0" />

    <!-- Crosscut Hosting -->
    <PackageVersion Include="GiantCroissant.Crosscut.Hosting.Contracts" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Crosscut.Hosting.Core" Version="0.1.0" />

    <!-- Crosscut Diagnostics -->
    <PackageVersion Include="GiantCroissant.Crosscut.Diagnostics.Contracts" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Crosscut.Diagnostics.Core" Version="0.1.0" />

    <!-- Infrastructure: time-dete -->
    <PackageVersion Include="TimeDete.Determinism.Abstractions" Version="0.1.0" />
    <PackageVersion Include="TimeDete.Determinism.Pcg" Version="0.1.0" />
    <PackageVersion Include="TimeDete.Time.Primitives" Version="0.1.0" />

    <!-- Infrastructure: unify-topology -->
    <PackageVersion Include="UnifyTopology.Graph.Abstractions" Version="0.1.0" />
    <PackageVersion Include="UnifyTopology.Graph.InMemory" Version="0.1.0" />

    <!-- Infrastructure: unify-maths -->
    <PackageVersion Include="UnifyGeometry.Primitives" Version="0.1.0" />
    <PackageVersion Include="UnifyGeometry.Operations" Version="0.1.0" />

    <!-- Mapping -->
    <PackageVersion Include="Riok.Mapperly" Version="4.1.0" />

    <!-- Infrastructure: unify-serialization -->
    <PackageVersion Include="UnifySerialization.Abstractions" Version="0.1.0" />
    <PackageVersion Include="UnifySerialization.Generators" Version="0.1.0" />

    <!-- Infrastructure: unify-storage -->
    <PackageVersion Include="UnifyStorage.Abstractions" Version="0.1.0" />
    <PackageVersion Include="UnifyStorage.Attributes" Version="0.1.0" />

    <!-- Infrastructure: plate-shared source generators -->
    <PackageVersion Include="GiantCroissant.Plate.SCG.General.AutoToString.Attributes" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Plate.SCG.General.DisposePattern.Attributes" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Plate.General.AutoProperties.Attributes" Version="0.1.0" />

    <!-- Infrastructure: plugin-archi -->
    <PackageVersion Include="GiantCroissant.Plate.PluginArchi.Contracts" Version="0.1.0" />
    <PackageVersion Include="GiantCroissant.Plate.PluginArchi.Extensibility.Abstractions" Version="0.1.0" />

    <!-- Godot -->
    <PackageVersion Include="Godot.NET.Sdk" Version="4.6.0" />

    <!-- Polyfills for netstandard2.1 -->
    <PackageVersion Include="PolySharp" Version="1.15.0" />
    <PackageVersion Include="System.Collections.Immutable" Version="9.0.1" />
    <PackageVersion Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>
</Project>
